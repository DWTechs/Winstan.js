{
  "name": "@dwtechs/winstan",
  "version": "0.7.0",
  "type": "module",
  "description": "Open source log library for Node.js for easy and lightweight logging.",
  "keywords": [
    "logs",
    "logger"
  ],
  "homepage": "https://github.com/DWTechs/Winstan.js",
  "main": "dist/winstan",
  "types": "dist/winstan",
  "repository": {
    "type": "git",
    "url": "https://github.com/DWTechs/Winstan.js"
  },
  "bugs": {
    "url": "https://github.com/DWTechs/Winstan.js/issues",
    "email": ""
  },
  "license": "MIT",
  "author": {
    "name": "Ludovic Cluber",
    "email": "http://www.lcluber.com/contact",
    "url": "http://www.lcluber.com"
  },
  "contributors": [],
  "scripts": {
    "start": "",
    "prebuild": "npm install",
    "build": "node ./scripts/clear.cjs && tsc -p tsconfig.lib.json && npm run rollup && node ./scripts/copy.cjs && npm run test:all",
    "rollup:mjs": "rollup --config rollup.config.mjs",
    "rollup:cjs": "rollup --config rollup.config.cjs.mjs",
    "rollup": "npm run rollup:mjs",
    "test": "tsc -p tsconfig.test.json && node ./tstests/src/app.js",
    "test:unit": "NODE_OPTIONS=--experimental-vm-modules jest --coverage",
    "test:all": "npm run test && npm run test:unit"
  },
  "files": [
    "dist/"
  ],
  "dependencies": {
    "@dwtechs/checkard": "3.6.0"
  },
  "devDependencies": {
    "@rollup/plugin-node-resolve": "16.0.3",
    "@types/jest": "30.0.0",
    "@types/node": "25.5.2",
    "core-js": "3.49.0",
    "jest": "30.3.0",
    "rollup": "4.60.1",
    "ts-jest": "29.4.9",
    "typescript": "6.0.2"
  }
}
